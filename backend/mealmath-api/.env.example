# Modelo das variaveis de ambiente da API. Copie para .env e preencha:
#   cp .env.example .env
# O .env fica fora do controle de versao (.gitignore) — nunca comite valores reais.
#
# Para carregar antes de rodar a aplicacao ou os testes:
#   set -a; source .env; set +a
#   ./mvnw spring-boot:run

# Banco de dados
DB_URL=jdbc:postgresql://localhost:5432/dietacusto_db
DB_USUARIO=postgres
DB_SENHA=troque-pela-senha-do-seu-postgres

# Segredo de assinatura do JWT. Minimo de 32 bytes para HS256.
# Gere um novo com: openssl rand -base64 48
APP_JWT_SEGREDO=gere-o-seu-com-openssl-rand-base64-48

# Origens liberadas no CORS, separadas por virgula. Opcional: sem a variavel
# vale o default de application.properties (dev server em :4200).
# APP_CORS_ORIGENS=http://localhost:4200,https://meu-dominio.exemplo
